# --- Database ---
DATABASE_ROOT_USER=
DATABASE_ROOT_PASS=
DATABASE_NAME=
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<database>
# --- Ports ---
FRONTEND_PORT=5173
BACKEND_PORT=3002
# --- Auth ---
# Generate a strong, random secret (do NOT commit a real value):
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=3d
# --- App ---
NODE_ENV=development
# CORS allowed origin / Socket.IO origin (the frontend URL)
FRONTEND_URL=http://localhost:5173
# Required only when running prisma/seed.js to create the initial admin account.
SEED_ADMIN_PASSWORD=